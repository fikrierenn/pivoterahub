# ─── Auth (next-auth v4 CredentialsProvider) ──────────────────
# Tek kullanıcılı MVP — production'da kullanıcı tablosu + bcrypt'e taşınacak.
AUTH_EMAIL=
AUTH_PASSWORD=
# `openssl rand -base64 32` veya `npx auth secret` ile üret.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Providers ─────────────────────────────────────────────
# OpenAI — sadece Vision + TTS fallback
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_DIRECTOR_MODEL=gpt-4o-mini

# Gemini — JSON skor + transkripsiyon (free tier)
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_FREE_MODEL=gemini-2.5-flash

# Claude — FrameAgent chat (Haiku ucuz, Sonnet karmaşık reasoning)
ANTHROPIC_API_KEY=
CLAUDE_AGENT_MODEL=claude-haiku-4-5-20251001
CLAUDE_AGENT_COMPLEX_MODEL=claude-sonnet-4-6

# Groq — Director script (ücretsiz Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ElevenLabs — kaliteli TTS (opsiyonel)
ELEVENLABS_API_KEY=

# ─── Python Microservice (FAZ 5 — opsiyonel) ──────────────────
ANALYSIS_SERVICE_URL=http://localhost:8001
